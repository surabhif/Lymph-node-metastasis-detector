    "max_eval_samples": 4000,
    "seed": 42,
    "index_seed": 49,
    "batch_size": 64,
    "decision_threshold": 0.5,
    "backbone": "resnet18",
    "onnx": "web/public/models/pcam_cam.onnx",
    "source_run_id": "full_pcam_int8_v1"
  },
